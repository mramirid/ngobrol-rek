rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isProjectActive() {
      // Active before 9 December 2024
      return request.time < timestamp.date(2024, 12, 9);
    }
    
    match /messages/{id} {
      allow list: if isProjectActive();
      allow create: if isSignedIn() && isProjectActive();
    }
  }
}